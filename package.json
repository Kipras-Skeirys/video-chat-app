{
  "name": "video-chat-app",
  "version": "1.0.7",
  "private": true,
  "description": "Random one-to-one video chat: Socket.IO matchmaking/signalling with peer-to-peer WebRTC media (portfolio demo).",
  "proxy": "http://localhost:8000",
  "homepage": ".",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "react-scripts": "^5.0.1",
    "sass": "^1.52.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-session": "^1.17.3",
    "lru-cache": "^7.14.1",
    "memorystore": "^1.6.7",
    "mongoose": "^6.8.4",
    "react": "^18.1.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.1.0",
    "react-router-dom": "^6.3.0",
    "socket.io": "^4.5.1",
    "socket.io-client": "^4.5.1",
    "uuid": "^9.0.0",
    "webrtc-adapter": "^8.2.0"
  },
  "scripts": {
    "start": "node ./back-end/server.js",
    "build": "react-app-rewired build",
    "front-end": "react-app-rewired start",
    "back-end": "node --watch ./back-end/server.js",
    "lint": "eslint --max-warnings=-1 back-end front-end/src",
    "mongo:up": "docker compose up -d mongo",
    "mongo:down": "docker compose down"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
