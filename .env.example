# Copy to .env and adjust. Every value here is a placeholder; the defaults work for the local demo.
# The same file is read by the Express server (dotenv) and by the CRA build (REACT_APP_* only).

# --- Server ---
PORT=8000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to accept connections from other devices (see README).
HOST=127.0.0.1
# Required for anything beyond a throwaway local run. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Comma-separated origins allowed to call the API cross-origin (empty = same origin only)
CORS_ORIGINS=
# Set to "true" (or a proxy count/subnet) only when running behind a reverse proxy
TRUST_PROXY=

# --- MongoDB (optional - only stores activity logs; the app runs without it) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=video_chat_app

# --- Matchmaking ---
# How often the same two people may be matched within 12h. 0 = unlimited (best for a two-person demo).
MAX_REPEAT_MATCHES=0
# Time allowed for both browsers to reach RTCPeerConnection "connected"
WEBRTC_CONNECT_TIMEOUT_MS=20000

# --- ICE (STUN/TURN) - optional, see README "Optional STUN/TURN" ---
# local (default, iceServers: []) | static | turn-rest | xirsys
ICE_MODE=local
# all (default) | relay  (relay forces TURN; ignored in local mode)
ICE_TRANSPORT_POLICY=all

# static mode: JSON array of RTCIceServer objects sent to browsers as-is
# ICE_SERVERS_JSON=[{"urls":"stun:stun.example.invalid:3478"}]

# turn-rest mode (coturn "use-auth-secret"): regional servers + server-side shared secret.
# The secret is used to derive short-lived credentials and is never sent to browsers.
# ICE_REGIONS_FILE=./config/ice-regions.json
# TURN_SECRET=replace-with-the-coturn-static-auth-secret
# TURN_CREDENTIAL_TTL_SECONDS=60
# TURN_USERNAME_SUFFIX=video-chat-app
# ICE_REGION_COUNT=3
# Request header with the client's ISO country code, used to pick the nearest regions
# ICE_COUNTRY_HEADER=cf-ipcountry

# xirsys mode
# XIRSYS_IDENT=replace-me
# XIRSYS_SECRET=replace-me
# XIRSYS_CHANNEL=replace-me

# --- Front-end (baked in at build time) ---
# Show the static banner-ad placeholder above the chat on desktop widths
REACT_APP_CHAT_AD_ENABLED=true
# Minimum milliseconds between two mock ads (the ad itself always lasts 5 s)
REACT_APP_MOCK_AD_INTERVAL_MS=30000
